#compdef mreview
# zsh completion for mreview
#
# Install: copy or symlink this file to a directory in $fpath, e.g.
#   /opt/homebrew/share/zsh/site-functions/_mreview
# then run `compinit` (or open a new shell) to pick it up.
# If completions still show stale results, clear cache:
#   rm -f ~/.zcompdump*; compinit

_mreview() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(- *)'{-v,--version}'[print version and exit]' \
    '--no-build[skip latexmk build, use existing outputs]' \
    '--draft[open TUI even when the build fails]' \
    '--build-cmd=[override latexmk command]:command:' \
    '--sidecar=[path to sidecar .mreview.md]:sidecar file:_files' \
    '--stdout=[format for annotations emitted on quit]:format:(md json none)' \
    '--config=[path to config file]:config file:_files -g "*.toml"' \
    '--noconfig[ignore config files; use built-in defaults]' \
    '--allow-modifications[allow in-TUI edits to the source file (e/E); default is read-only]' \
    '1: :->cmd_or_paper' \
    '*:: :->args'

  case $state in
    cmd_or_paper)
      _alternative \
        'commands:subcommand:((fmt\:reformat\ a\ paper\ in\ place diff\:run\ a\ semantic\ before\ slash\ after\ review\ for\ two\ endpoints config\:edit\ the\ global\ config\ in\ \$EDITOR pdf-comments\:anchor\ AI\ review\ comments\ to\ a\ PDF pdf-review\:open\ the\ side-by-side\ review\ TUI))' \
        'files:tex file:_files -g "*.tex"'
      ;;
    args)
      case $line[1] in
        fmt)
          _mreview_fmt ;;
        diff)
          _mreview_diff ;;
        config)
          ;;
        pdf-comments)
          _mreview_pdf_comments ;;
        pdf-review)
          _mreview_pdf_review ;;
        *)
          _files -g '*.tex' ;;
      esac
      ;;
  esac
}

_mreview_fmt() {
  _arguments \
    '(--print --check)--diff[show unified diff to stdout, do not write]' \
    '(--diff --check -p --print)'{-p,--print}'[print formatted source to stdout, do not write]' \
    '(--diff --print)--check[exit 1 if changes needed]' \
    '*--rule=[restrict to these rule IDs]:rule id:' \
    '*--skip-rule=[disable these rule IDs even when otherwise enabled]:rule id:' \
    '--list-rules[print all registered rule IDs and exit]' \
    '--allow-dirty[skip dirty-tree check before writing]' \
    '--no-verify[skip PDF verification entirely (one-off)]' \
    '--no-report[do not write paper.tex.fmt-report.md (one-off)]' \
    '--clean-tempdir[remove all mr-fmt-* verification tempdirs]' \
    '--config=[path to config file]:config file:_files -g "*.toml"' \
    '--noconfig[ignore config files; use built-in defaults]' \
    '*:tex file:_files -g "*.tex"'
}

_mreview_diff() {
  _arguments \
    '--base=[compare REV:path against working-tree path]:git revision or endpoint:' \
    '--no-build[skip latexmk build for the new endpoint]' \
    '--draft[open TUI even when the new build fails]' \
    '--build-cmd=[override latexmk command for the new endpoint]:command:' \
    '--sidecar=[path to diff sidecar file]:sidecar file:_files' \
    '--stdout=[format for diff annotations emitted on quit]:format:(md json none)' \
    '--config=[path to config file]:config file:_files -g "*.toml"' \
    '--noconfig[ignore config files; use built-in defaults]' \
    '--open-compare[open old+new in external compare editor after startup]' \
    '--open-zed[deprecated alias for --open-compare]' \
    '--allow-modifications[allow e/E edits to the new endpoint when it is a real file]' \
    '*:endpoint/file:_files'
}

_mreview_pdf_comments() {
  _arguments \
    '--model=[claude --model value (default: opus)]:model:' \
    '--out=[output JSON path (default: <PDF>.pdf-comments.json)]:out:_files -g "*.json"' \
    '1:review markdown or preprint pdf:_files -g "*.(md|pdf)"' \
    '2:review markdown or preprint pdf:_files -g "*.(md|pdf)"'
}

_mreview_pdf_review() {
  _arguments \
    '--out=[output letter path (default: <PDF>.review.md)]:out:_files -g "*.md"' \
    '1:preprint pdf:_files -g "*.pdf"'
}

_mreview "$@"
